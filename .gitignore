# Python compilation
__pycache__/
*.py[cod]
*$py.class

# Packaging (pip install . builds these in place; deploy.sh runs that
# on the VM on every deploy, so they must not accumulate there)
build/
*.egg-info/

# Harvest folder
output/

# Virtual Environments
venv/
.venv/
env/

# IDE settings (PyCharm/VSCode)
.idea/
.vscode/
*.swp
*.iml

# Temporary/Generated files
tree.txt
debug_harvester.py
test_parser_logic.py

# OS generated
.DS_Store
Thumbs.db

# Local credentials
repo_harvester_server/helper/fairsharing_credentials.json

# Apache Jena Fuseki (if accidentally downloaded here)
apache-jena-fuseki-*/
*.tar.gz

# Operational runbooks: they describe our specific VM, not the software,
# and this repository is public. Kept on disk, out of the repo.
docs/deploy-eu-node.md
docs/eosc-eu-node-service-runbook.md
docs/eosc-eu-node-service-runbook.docx
