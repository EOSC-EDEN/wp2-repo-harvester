      <div class="controls">
        <button id="parseBtn">Parse to HTML</button>
        <button id="clearBtn" class="secondary">Clear</button>
      </div>
    </div>

    <!-- Output Column -->
    <div class="panel">
      <div style="font-weight:600; margin-bottom:0.75rem;">Rendered HTML Output:</div>
      <div id="output"></div>
    </div>
  </div>
</div>
<script>
  const inputEl = document.getElementById('jsonInput');
  const outputEl = document.getElementById('output');

  // Fjern <script type="application/ld+json">-omslaget hvis det finnes
  function extractJsonString(raw) {
    return raw
      .trim()
      .replace(/^<script[^>]*>/i, '')
      .replace(/<\/script>$/i, '')
      .trim();
  }

  // Gjør camelCase eller @-nøkler om til lesbare etiketter
  function formatLabel(key) {
    if (key === '@id') return 'ID';
    if (key === '@type') return 'Type';
    if (key === '@context') return 'Context';
    return key
      .replace(/^@/, '')
      .replace(/([a-z])([A-Z])/g, '$1 $2')
      .replace(/^./, str => str.toUpperCase());
  }

  // Formater enkeltverdier (nettadresser, e-post, boolske verdier og tekst med linjeskift)
  function renderPrimitive(val) {
    if (val === null || val === undefined) {
      const span = document.createElement('span');
      span.style.color = '#94a3b8';
      span.textContent = 'null';
      return span;
    }

    if (typeof val === 'boolean') {
      const span = document.createElement('span');
      span.textContent = val ? 'Yes (true)' : 'No (false)';
      return span;
    }

    const str = String(val);

    // Sjekk etter HTTP/HTTPS-nettadresse
    if (/^https?:\/\/\S+$/i.test(str)) {
      const a = document.createElement('a');
      a.href = str;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = str;
      return a;
    }

    // Sjekk etter e-postadresse
    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(str)) {
      const a = document.createElement('a');
      a.href = `mailto:${str}`;
      a.textContent = str;
      return a;
    }

    // Bevar linjeskift for beskrivelser og kommentarer
    const p = document.createElement('p');
    p.className = 'multiline-text';
    p.textContent = str;
    return p;
  }
  // Bygg HTML-kort og tabeller rekursivt for objekter og lister
  function renderNode(data) {
    // Håndter lister (Arrays)
    if (Array.isArray(data)) {
      const allPrimitives = data.every(item => item === null || typeof item !== 'object');

      if (allPrimitives) {
        const tagList = document.createElement('div');
        tagList.className = 'tag-list';
        data.forEach(item => {
          const tag = document.createElement('span');
          tag.className = 'tag';
          tag.appendChild(renderPrimitive(item));
          tagList.appendChild(tag);
        });
        return tagList;
      }

      const wrapper = document.createElement('div');
      data.forEach(item => wrapper.appendChild(renderNode(item)));
      return wrapper;
    }

    // Håndter objekter
    if (typeof data === 'object' && data !== null) {
      const card = document.createElement('div');
      card.className = 'entity-card';

      // Vis @type-merke og navn i en topptekst hvis tilgjengelig
      if (data['@type'] || data['name']) {
        const header = document.createElement('div');
        header.className = 'entity-header';

        if (data['@type']) {
          const badge = document.createElement('span');
          badge.className = 'type-badge';
          badge.textContent = Array.isArray(data['@type']) ? data['@type'].join(', ') : data['@type'];
          header.appendChild(badge);
        }

        if (data['name']) {
          const title = document.createElement('strong');
          title.textContent = data['name'];
          header.appendChild(title);
        }

        card.appendChild(header);
      }

      const table = document.createElement('table');
      table.className = 'prop-table';

      Object.entries(data).forEach(([key, value]) => {
        // Hopp over @context og @type som allerede er vist i toppteksten
        if (key === '@context' || key === '@type') return;

        const tr = document.createElement('tr');
        const tdKey = document.createElement('td');
        tdKey.className = 'prop-key';
        tdKey.textContent = formatLabel(key);

        const tdVal = document.createElement('td');
        tdVal.className = 'prop-val';
        tdVal.appendChild(renderNode(value));

        tr.appendChild(tdKey);
        tr.appendChild(tdVal);
        table.appendChild(tr);
      });

      card.appendChild(table);
      return card;
    }

    // Standard visning for enkeltverdier
    return renderPrimitive(data);
  }

  function parseAndRender() {
    outputEl.innerHTML = '';
    const cleaned = extractJsonString(inputEl.value);

    if (!cleaned) {
      outputEl.innerHTML = '<div class="error">Please paste valid JSON-LD into the text area.</div>';
      return;
    }

    try {
      const parsed = JSON.parse(cleaned);
      outputEl.appendChild(renderNode(parsed));
    } catch (err) {
      outputEl.innerHTML = `<div class="error"><strong>JSON Parse Error:</strong> ${err.message}</div>`;
    }
  }

  document.getElementById('parseBtn').addEventListener('click', parseAndRender);
  document.getElementById('clearBtn').addEventListener('click', () => {
    inputEl.value = '';
    outputEl.innerHTML = '';
  });

  // Vis standardeksempelet umiddelbart når siden lastes
  parseAndRender();
</script>

</body>
</html>
