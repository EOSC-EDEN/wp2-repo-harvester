# Which registries a harvest may consult.
# re3data needs no credentials and has never rate-limited us.
# Add ',fairsharing' once the EDEN FAIRsharing service account exists - and add
# a response cache first: the 5-second pacing is per process, so concurrent
# visitors re-triggering the same lookups walk straight into 429s.
EDEN_ENABLED_REGISTRIES=re3data

# FUSEKI_PATH must be present and empty. Persistence is on by default, so
# deleting this line makes the demo try to write to a Fuseki that is not there.
# Empty means "deliberately no triple store": nothing is persisted or
# harmonized, and no FUSEKI credentials are asked for.
FUSEKI_PATH=

# FAIRSHARING_USERNAME=
# FAIRSHARING_PASSWORD=
