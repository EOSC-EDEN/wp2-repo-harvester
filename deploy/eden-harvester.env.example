# Which registries a harvest may consult.
# re3data needs no credentials and has never rate-limited us. Nor does
# coretrustseal: one request fetches its whole certificate list, refreshed daily.
# fairsharing needs the EDEN account's credentials below; add ',fairsharing'
# once they are filled in.
EDEN_ENABLED_REGISTRIES=re3data,coretrustseal

# FUSEKI_PATH must be present and empty. Persistence is on by default, so
# deleting this line makes the demo try to write to a Fuseki that is not there.
# Empty means "deliberately no triple store": nothing is persisted or
# harmonized, and no FUSEKI credentials are asked for.
FUSEKI_PATH=

# FAIRSHARING_USERNAME=
# FAIRSHARING_PASSWORD=

# Read by uvicorn itself. The entry VM reaches this VM over eden-net, so bind
# this VM's private IP: loopback is unreachable from there, and 0.0.0.0 would
# listen on every interface. eden-service already allows 8000 from eden-entry.
UVICORN_HOST=192.168.0.x
UVICORN_PORT=8000

# The entry VM's private IP. uvicorn only believes X-Forwarded-Proto from the
# addresses listed here; without it, the app's own redirects, such as
# /api/ui -> /api/ui/, point at http://.
UVICORN_FORWARDED_ALLOW_IPS=192.168.0.111
